      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ativos · 30 dias",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(prephub_usuarios_ativos{janela=\"30d\"})",
          "instant": true,
          "legendFormat": "30d"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Provas em andamento",
      "description": "Tentativas abertas, sem encerramento gravado. Um número que só cresce indica provas abandonadas — o servidor as fecha sozinho quando alguém reabre a página depois do prazo, não por varredura.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(prephub_provas_em_andamento)",
          "instant": true,
          "legendFormat": "em andamento"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Provas concluídas",
      "description": "Total histórico de tentativas encerradas, manual ou por tempo.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(prephub_provas_realizadas)",
          "instant": true,
          "legendFormat": "concluídas"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Contas por caminho de entrada",
      "description": "Mostra qual forma de login vale a pena manter. Cada par (provedor, chave) é uma conta distinta: a mesma pessoa com o mesmo e-mail no Google e no GitHub aparece duas vezes, por decisão de modelagem.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (provedor) (prephub_usuarios_cadastrados)",
          "instant": true,
          "legendFormat": "{{provedor}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Contas novas",
      "description": "Cadastros concluídos ao longo do tempo, por caminho de entrada. Vem de contador: o gráfico mostra a variação no intervalo, não o acumulado.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (provedor) (increase(prephub_contas_criadas_total[$__rate_interval]))",
          "legendFormat": "{{provedor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tentativas de login",
      "description": "Por desfecho. A TELA não distingue esses casos de propósito (qualquer falha devolve a mesma mensagem, para não revelar quem tem conta); a distinção existe só aqui, e é ela que deixa uma força bruta visível — uma linha de senha_incorreta ou conta_bloqueada subindo sozinha.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (resultado) (increase(prephub_logins_total[$__rate_interval]))",
          "legendFormat": "{{resultado}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sucesso" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "conta_bloqueada" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Taxa de aprovação",
      "description": "Proporção histórica de provas encerradas com nota igual ou acima do corte (700 na escala 1–1000). Sem prova concluída no banco a divisão não tem resultado e o painel fica vazio — de propósito, é diferente de 0%.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(prephub_provas_realizadas{resultado=\"aprovado\"}) / sum(prephub_provas_realizadas)",
          "instant": true,
          "legendFormat": "aprovação"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Nota final (escala 1–1000)",
      "description": "Mediana e percentil 90 das notas no período. A linha em 700 é o corte: mediana abaixo dela significa que o banco de questões está mais difícil do que quem o usa consegue acompanhar — ou que está calibrado como deveria, dependendo de quem responde.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 6, "w": 10, "x": 4, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(prephub_provas_nota_bucket[$__rate_interval])))",
          "legendFormat": "mediana"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(prephub_provas_nota_bucket[$__rate_interval])))",
          "legendFormat": "p90"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "max": 1000,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 700 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 22,
      "type": "heatmap",
      "title": "Distribuição das notas",
      "description": "Quantas provas caíram em cada faixa de nota. As faixas do histograma se adensam em volta de 700 porque é ali que a diferença tem significado — entre 100 e 200 não muda nada.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (le) (increase(prephub_provas_nota_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } } },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Blues", "steps": 32, "reverse": false, "exponent": 0.5, "fill": "dark-blue" },
        "legend": { "show": true },
        "tooltip": { "show": true, "yHistogram": false },
        "yAxis": { "axisPlacement": "left", "unit": "short", "decimals": 0 }
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Provas iniciadas x concluídas",
      "description": "A distância entre as duas linhas é abandono: gente que clicou em iniciar e não terminou.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(increase(prephub_provas_iniciadas_total[$__rate_interval]))",
          "legendFormat": "iniciadas"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(increase(prephub_provas_concluidas_total[$__rate_interval]))",
          "legendFormat": "concluídas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Duração da prova",
      "description": "Mediana e p90 do tempo entre iniciar e encerrar. O limite do AZ-900 é 45 minutos; p90 encostado nele significa gente entregando no estouro do tempo.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(prephub_provas_duracao_seconds_bucket[$__rate_interval])))",
          "legendFormat": "mediana"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(prephub_provas_duracao_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p90"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 2700 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 32,
      "type": "piechart",
      "title": "Como a prova terminou",
      "description": "Encerramento manual contra submissão automática por tempo esgotado. Timer zerado sempre submete, sem exceção — e é o servidor quem aplica a regra.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (motivo) (increase(prephub_provas_concluidas_total[$__range]))",
          "instant": true,
          "legendFormat": "{{motivo}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "pie",
        "displayLabels": ["name", "value"],
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Cadastros recusados",
      "description": "Por motivo. email_ja_cadastrado em volume alto sugere gente com conta tentando criar outra — normalmente porque entrou por um provedor social e não lembra qual.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (motivo) (increase(prephub_cadastros_recusados_total[$__rate_interval]))",
          "legendFormat": "{{motivo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Redefinição de senha",
      "description": "solicitada conta todo pedido; link_emitido, só os que tinham conta local por trás. Muita solicitação sem emissão é alguém varrendo e-mails para descobrir quem tem cadastro aqui — a tela responde igual nos dois casos justamente para não confirmar.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum by (etapa) (increase(prephub_redefinicoes_senha_total[$__rate_interval]))",
          "legendFormat": "{{etapa}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Idade do retrato do banco",
