{
  "uid": "prephub-produto",
  "title": "PrepHub · Produto",
  "description": "Quem usa o simulado e o que acontece com as provas. Os números de estoque (contas, provas realizadas) vêm de medidores recontados no banco a cada 30s e sobrevivem a deploy; os de movimento vêm de contadores, que zeram quando o processo reinicia — por isso são sempre lidos como taxa ou variação no período.",
  "tags": ["prephub", "produto"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Contas cadastradas",
      "description": "Total de contas existentes no banco, somando login local e provedores sociais. Não zera com deploy: o valor é recontado no banco, não acumulado em memória.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(prephub_usuarios_cadastrados)",
          "instant": true,
          "legendFormat": "contas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ativos · 24h",
      "description": "Contas com acesso registrado nas últimas 24 horas. Cadastro só sobe; é este número que diz se alguém ainda está usando.",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
          "expr": "sum(prephub_usuarios_ativos{janela=\"24h\"})",
          "instant": true,
          "legendFormat": "24h"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Ativos · 7 dias",
      "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prephub-prometheus" },
