<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PrepHub.Application\PrepHub.Application.csproj" />
    <ProjectReference Include="..\PrepHub.Domain\PrepHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O banco de questões viaja dentro do assembly: adicionar um lote é adicionar um JSON
         aqui, sem tocar em código e sem depender de arquivo copiado junto no deploy. -->
    <EmbeddedResource Include="Persistence\Seed\Questoes\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Sobrepõe a dependência transitiva vulnerável (NU1903, GHSA-2m69-gcr7-jv3q) do EF Core. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />

    <!-- Observabilidade. Nenhum pacote de vendor aqui de propósito: o Meter vem da BCL
         (System.Diagnostics.Metrics, já no framework) e quem exporta para o Prometheus é o
         OpenTelemetry, montado no Web. Este pacote entra só pelo BackgroundService que
         reconta o banco. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
