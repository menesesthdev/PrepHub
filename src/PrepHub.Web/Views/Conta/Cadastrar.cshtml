@using PrepHub.Domain.Autenticacao
@model CadastroViewModel
@{
    Layout = null;

    var falhaGeral = ViewData.ModelState.TryGetValue(string.Empty, out var geral) && geral.Errors.Count > 0
        ? geral.Errors[0].ErrorMessage
        : null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Criar conta · PrepHub</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login">
        <div class="login__card">
            <div class="login__brand">
                <span class="login__logo">
                    <img src="~/img/logo-prephub.png" asp-append-version="true"
                         width="240" height="200" decoding="async"
                         alt="PrepHub — simulados de certificação" />
                </span>
            </div>

            <h1 class="login__title">Criar conta</h1>
            <p class="login__lead">
                Leva menos de um minuto. Sua conta guarda o histórico das suas tentativas.
            </p>

            @if (falhaGeral is not null)
            {
                <p class="login__error" role="alert">@falhaGeral</p>
            }

            <form class="auth-form" asp-action="Cadastrar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="field">
                    <label class="field__label" asp-for="Nome"></label>
                    <input class="field__input" asp-for="Nome" autocomplete="name" />
                    <span class="field__error" asp-validation-for="Nome"></span>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="Email"></label>
                    <input class="field__input" asp-for="Email" type="email"
                           autocomplete="email" autocapitalize="none" spellcheck="false"
                           placeholder="voce@exemplo.com" />
                    <span class="field__error" asp-validation-for="Email"></span>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="Senha"></label>
                    <input class="field__input" asp-for="Senha" type="password"
                           autocomplete="new-password" />
                    <span class="field__hint">Mínimo de @PoliticaDeSenha.TamanhoMinimo caracteres.</span>
                    <span class="field__error" asp-validation-for="Senha"></span>
                </div>

                <div class="field">
                    <label class="field__label" asp-for="ConfirmacaoDeSenha"></label>
                    <input class="field__input" asp-for="ConfirmacaoDeSenha" type="password"
                           autocomplete="new-password" />
                    <span class="field__error" asp-validation-for="ConfirmacaoDeSenha"></span>
                </div>

                <button type="submit" class="btn btn--primary auth-form__submit">Criar conta</button>
            </form>

            <p class="login__alt">
                Já tem conta?
                <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Entrar</a>
            </p>

            <p class="login__legal">
                Ao criar sua conta, você concorda que usamos seus dados apenas para identificar
                suas tentativas e salvar seu histórico de simulados.
            </p>
        </div>

        <p class="login__footnote">
            Questões 100% originais, escritas a partir do Skills Measured outline oficial.
            Este simulado não reproduz conteúdo real de provas.
        </p>
    </main>
</body>
</html>
