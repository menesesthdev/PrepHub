@using PrepHub.Domain.Autenticacao
@model ConfirmeSeuEmailViewModel
@{
    Layout = null;
    var horas = (int)PoliticaDeConfirmacaoDeEmail.Validade.TotalHours;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirme seu e-mail · PrepHub</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login">
        <div class="login__card">
            <div class="login__brand">
                <span class="login__logo">
                    <img src="~/img/logo-prephub.png" asp-append-version="true"
                         width="240" height="200" decoding="async"
                         alt="PrepHub — simulados de certificação" />
                </span>
            </div>

            <h1 class="login__title">Confirme seu e-mail</h1>

            @if (Model.Reenviado)
            {
                <p class="login__sucesso" role="status">
                    Link reenviado. O anterior deixou de valer.
                </p>
            }

            <p class="login__lead">
                Sua conta foi criada. Enviamos um link de confirmação
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <text>para <strong>@Model.Email</strong></text>
                }
                — abra esse link para poder entrar.
            </p>

            <p class="login__hint">
                O link vale por @horas horas. Não chegou? Confira a caixa de spam e o lixo
                eletrônico. Se o endereço acima estiver errado, peça um link novo com o e-mail
                correto.
            </p>

            <p class="login__alt">
                <a asp-action="ReenviarConfirmacao" asp-route-email="@Model.Email">Reenviar o link</a>
            </p>

            <p class="login__alt">
                <a asp-action="Login">Voltar para o login</a>
            </p>
        </div>

        <p class="login__footnote">
            Questões 100% originais, escritas a partir do Skills Measured outline oficial.
            Este simulado não reproduz conteúdo real de provas.
        </p>
    </main>
</body>
</html>
