@model LoginViewModel
@{
    Layout = null;
    var erro = Context.Request.Query.ContainsKey("erro");
    var senhaAlterada = Context.Request.Query.ContainsKey("senhaAlterada");
    var emailConfirmado = Context.Request.Query.ContainsKey("emailConfirmado");

    // Chega por redirect do limitador de requisições (OnRejected), não por ação do controller.
    var limiteAtingido = Context.Request.Query.ContainsKey("limite");

    // Erros que não pertencem a um campo — hoje, "e-mail ou senha incorretos". Renderizados
    // à mão em vez de asp-validation-summary porque o summary emite marcação vazia quando
    // não há erro, e aí o espaçamento do card muda sem nada na tela.
    var falhaDeCredencial = ViewData.ModelState.TryGetValue(string.Empty, out var geral)
                            && geral.Errors.Count > 0
        ? geral.Errors[0].ErrorMessage
        : null;

    // Rótulo e glifo de cada provedor. O SVG é inline para não haver requisição extra
    // nem dependência externa na primeira tela que a pessoa vê.
    var provedores = new Dictionary<string, (string Rotulo, string Css)>
    {
        ["Google"] = ("Google", "google"),
        ["LinkedIn"] = ("LinkedIn", "linkedin"),
        ["GitHub"] = ("GitHub", "github")
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Entrar · PrepHub</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login">
        <div class="login__card">
            <div class="login__brand">
                @* A logo já traz o nome e o descritivo, então aqui ela substitui o texto
                   em vez de duplicá-lo — o alt cobre quem não carrega a imagem. *@
                <span class="login__logo">
                    <img src="~/img/logo-prephub.png" asp-append-version="true"
                         width="240" height="200" decoding="async"
                         alt="PrepHub — simulados de certificação" />
                </span>
            </div>

            <h1 class="login__title">Entrar</h1>
            <p class="login__lead">
                Use seu e-mail e senha, ou entre com uma conta que você já tem.
            </p>

            @if (senhaAlterada)
            {
                <p class="login__sucesso" role="status">
                    Senha alterada. Entre com a nova senha.
                </p>
            }

            @if (emailConfirmado)
            {
                <p class="login__sucesso" role="status">
                    E-mail confirmado. Agora é só entrar.
                </p>
            }

            @if (Model.EmailNaoConfirmado)
            {
                @* Único erro de login que nomeia a causa. Chega aqui só quem acertou a senha,
                   então não revela cadastro a ninguém — ver FalhaDeAutenticacao.EmailNaoConfirmado. *@
                <p class="login__error" role="alert">
                    Falta confirmar seu e-mail. Abra o link que enviamos para entrar.
                    <a asp-action="ReenviarConfirmacao" asp-route-email="@Model.Email">Reenviar o link</a>
                </p>
            }

            @if (limiteAtingido)
            {
                @* Aviso por IP, não por conta: não revela se algum e-mail tem cadastro aqui. *@
                <p class="login__error" role="alert">
                    Muitas tentativas a partir deste computador. Aguarde alguns minutos e
                    tente de novo.
                </p>
            }

            @if (erro)
            {
                <p class="login__error" role="alert">
                    Não foi possível concluir o login. Tente novamente.
                </p>
            }

            @if (falhaDeCredencial is not null)
            {
                <p class="login__error" role="alert">@falhaDeCredencial</p>
            }

            <form class="auth-form" asp-action="EntrarComSenha" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="field">
                    <label class="field__label" asp-for="Email"></label>
                    <input class="field__input" asp-for="Email" type="email"
                           autocomplete="email" autocapitalize="none" spellcheck="false"
                           placeholder="voce@exemplo.com" />
                    <span class="field__error" asp-validation-for="Email"></span>
                </div>

                <div class="field">
                    <div class="field__linha">
                        <label class="field__label" asp-for="Senha"></label>
                        <a class="field__acao" asp-action="EsqueciSenha">Esqueci minha senha</a>
                    </div>
                    <input class="field__input" asp-for="Senha" type="password"
                           autocomplete="current-password" />
                    <span class="field__error" asp-validation-for="Senha"></span>
                </div>

                <button type="submit" class="btn btn--primary auth-form__submit">Entrar</button>
            </form>

            @if (Model.Provedores.Count > 0)
            {
                <div class="login__divider"><span>ou continue com</span></div>

                <div class="login__providers">
                    @foreach (var scheme in Model.Provedores)
                    {
                        if (!provedores.TryGetValue(scheme, out var info))
                        {
                            continue;
                        }

                        <form asp-action="Entrar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="provider" value="@scheme" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="provider provider--@info.Css">
                                <span class="provider__icon" aria-hidden="true">
                                    @switch (scheme)
                                    {
                                        case "Google":
                                            <svg viewBox="0 0 18 18" width="18" height="18">
                                                <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" />
                                                <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" />
                                                <path fill="#FBBC05" d="M3.97 10.72a5.41 5.41 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z" />
                                                <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" />
                                            </svg>
                                            break;
                                        case "LinkedIn":
                                            <svg viewBox="0 0 24 24" width="18" height="18">
                                                <path fill="#0A66C2" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                                            </svg>
                                            break;
                                        case "GitHub":
                                            <svg viewBox="0 0 16 16" width="18" height="18">
                                                <path fill="#24292F" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                                            </svg>
                                            break;
                                    }
                                </span>
                                <span class="provider__label">Continuar com @info.Rotulo</span>
                            </button>
                        </form>
                    }
                </div>
            }

            <p class="login__alt">
                Não tem conta?
                <a asp-action="Cadastrar" asp-route-returnUrl="@Model.ReturnUrl">Cadastrar</a>
            </p>

            <p class="login__legal">
                Ao entrar, você concorda que usamos sua conta apenas para identificar suas
                tentativas e salvar seu histórico de simulados.
            </p>
        </div>

        <p class="login__footnote">
            Questões 100% originais, escritas a partir do Skills Measured outline oficial.
            Este simulado não reproduz conteúdo real de provas.
        </p>
    </main>
</body>
</html>
