@inject OpcoesDeDoacao Doacao
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · PrepHub</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" asp-controller="Home" asp-action="Index">
                <img class="site-brand__logo" src="~/img/icone-192.png" asp-append-version="true"
                     width="36" height="36" alt="" />
                <span class="site-brand__text">
                    <span class="site-brand__mark">PrepHub</span>
                    <span class="site-brand__sub">Simulados de certificação Microsoft e AWS</span>
                </span>
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                @* Navegação só para quem está logado: o histórico não existe sem conta. *@
                var atual = ViewContext.RouteData.Values["controller"]?.ToString();
                <nav class="site-nav">
                    <a class="site-nav__link @(atual == "Home" ? "site-nav__link--ativo" : "")"
                       asp-controller="Home" asp-action="Index">Exames</a>
                    <a class="site-nav__link @(atual == "Historico" ? "site-nav__link--ativo" : "")"
                       asp-controller="Historico" asp-action="Index">Meu histórico</a>
                </nav>

                var avatar = User.FindFirst("avatar")?.Value;
                <div class="site-user">
                    @if (!string.IsNullOrWhiteSpace(avatar))
                    {
                        <img class="site-user__avatar" src="@avatar" alt="" referrerpolicy="no-referrer" />
                    }
                    <span class="site-user__name">@User.Identity.Name</span>
                    <form asp-controller="Conta" asp-action="Sair" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn site-user__signout">Sair</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            Questões 100% originais, escritas a partir do Skills Measured outline oficial.
            Este simulado não reproduz conteúdo real de provas.

            @* Só aparece com chave Pix configurada — sem ela a rota nem existe. *@
            @if (Doacao.EstaConfigurado)
            {
                <p class="site-footer__apoio">
                    Gratuito e sem anúncios.
                    <a asp-controller="Apoiar" asp-action="Index">Apoiar o projeto</a>
                </p>
            }
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
