@*
    Seletor "Esquema de cores" da faixa de ferramentas AWS, com as mesmas nove combinações do demo
    oficial. O comportamento está em aws-esquema.js; o valor é a chave do [data-scheme] no CSS.
*@
<select class="aws-scheme" id="color-scheme" aria-label="Esquema de cores">
    <option value="">Esquema de cores</option>
    <option value="preto-amarelo-claro">Preto sobre amarelo-claro</option>
    <option value="preto-salmao">Preto sobre salmão</option>
    <option value="preto-branco">Preto sobre branco</option>
    <option value="preto-amarelo">Preto sobre amarelo</option>
    <option value="azul-branco">Azul sobre branco</option>
    <option value="azul-amarelo">Azul sobre amarelo</option>
    <option value="amarelo-claro-preto">Amarelo-claro sobre preto</option>
    <option value="branco-preto">Branco sobre preto</option>
    <option value="branco-azul">Branco sobre azul</option>
</select>
