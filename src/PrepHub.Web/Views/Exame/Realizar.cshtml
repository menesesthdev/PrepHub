@model RealizarProvaViewModel
@{
    Layout = null;
    var state = Model.State;
    var initialData = new
    {
        attemptId = state.AttemptId,
        remainingSeconds = state.RemainingSeconds,
        totalQuestions = state.Questions.Count,
        statuses = state.Questions.Select(q => new
        {
            number = q.Number,
            answered = q.IsAnswered,
            flagged = q.IsFlaggedForReview,
            selectedCount = q.SelectedCount,
            required = q.RequiredSelections
        }),
        urls = new
        {
            question = Url.Action("Questao", "Exame", new { attemptId = state.AttemptId, number = 0 })!.Replace("/0", "/{n}"),
            answer = Url.Action("SalvarResposta", "Exame", new { attemptId = state.AttemptId }),
            finish = Url.Action("Finalizar", "Exame", new { attemptId = state.AttemptId })
        }
    };
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@state.ExamCode · Simulado em andamento</title>
    <partial name="_Favicon" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="exam-body">
    @*
        Layout fiel à entrega real (Pearson VUE / Microsoft): barra superior com identificação
        e tempo, área única de conteúdo e barra de ações fixa embaixo. Sem painel lateral de
        navegação — na prova real a navegação é linear e o salto entre itens só acontece pela
        tela de revisão.
    *@
    <header class="exam-bar">
        <div class="exam-bar__title">
            <span class="exam-bar__code">@state.ExamCode</span>
            <span class="exam-bar__name">@state.ExamName</span>
        </div>
        <div class="exam-bar__clock">
            <span class="exam-bar__clock-label">Tempo restante</span>
            <span class="exam-bar__clock-value" id="timer" aria-live="off">--:--</span>
        </div>
    </header>

    <main class="exam-stage">
        <!-- Área da questão (trocada via AJAX, sem recarregar a página) -->
        <section class="exam-sheet" id="question-view">
            <div id="question-container">
                @await Html.PartialAsync("_Questao", Model.FirstQuestion)
            </div>
        </section>

        <!-- Tela de revisão: substitui a questão, como na prova real -->
        <section class="exam-sheet review-screen" id="review-view" hidden>
            <h1 class="review-screen__title">Tela de revisão</h1>
            <p class="review-screen__help">
                Selecione um item para voltar a ele. Itens incompletos e marcados aparecem
                destacados. Ao encerrar a prova, não será possível retornar.
            </p>

            <div class="review-screen__filters" role="group" aria-label="Filtrar itens">
                <button type="button" class="btn btn--filter is-active" data-filter="all">Revisar todos</button>
                <button type="button" class="btn btn--filter" data-filter="incomplete">Revisar incompletos</button>
                <button type="button" class="btn btn--filter" data-filter="marked">Revisar marcados</button>
            </div>

            <table class="review-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Status</th>
                        <th scope="col">Marcado</th>
                    </tr>
                </thead>
                <tbody id="review-rows"></tbody>
            </table>
            <p class="review-screen__empty" id="review-empty" hidden>Nenhum item nesta categoria.</p>
        </section>
    </main>

    <!-- Barra de ações fixa: marcação e comentários à esquerda, navegação à direita -->
    <footer class="exam-actions">
        <div class="exam-actions__left">
            <label class="mark-toggle">
                <input type="checkbox" id="flag-toggle" />
                <span>Marcar para revisão</span>
            </label>
            <button type="button" class="btn btn--link" id="btn-comments">Comentários</button>
        </div>
        <div class="exam-actions__right">
            <button type="button" class="btn" id="btn-review">Tela de revisão</button>
            <button type="button" class="btn" id="btn-prev">Anterior</button>
            <button type="button" class="btn btn--primary" id="btn-next">Próxima</button>
            <button type="button" class="btn btn--primary" id="btn-end" hidden>Encerrar prova</button>
        </div>
    </footer>

    <!-- Confirmação de encerramento -->
    <div class="modal" id="finish-modal" hidden>
        <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="finish-title">
            <h2 class="modal__title" id="finish-title">Encerrar a prova?</h2>
            <p class="modal__body" id="finish-summary"></p>
            <p class="modal__warning">Após encerrar, não será possível retornar aos itens.</p>
            <div class="modal__actions">
                <button type="button" class="btn" id="btn-finish-cancel">Voltar à prova</button>
                <button type="button" class="btn btn--primary" id="btn-finish-confirm">Encerrar prova</button>
            </div>
        </div>
    </div>

    <!-- Comentário sobre o item (a prova real permite enviar feedback por questão) -->
    <div class="modal" id="comments-modal" hidden>
        <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="comments-title">
            <h2 class="modal__title" id="comments-title">Comentários sobre o item</h2>
            <p class="modal__body">
                Registre aqui qualquer observação sobre este item. O comentário não afeta sua nota.
            </p>
            <textarea class="modal__textarea" id="comments-text" rows="6"></textarea>
            <div class="modal__actions">
                <button type="button" class="btn" id="btn-comments-cancel">Cancelar</button>
                <button type="button" class="btn btn--primary" id="btn-comments-save">Salvar</button>
            </div>
        </div>
    </div>

    @*
        Token antiforgery para as chamadas AJAX de gravar resposta e encerrar. Fica fora do JSON
        de dados de propósito: o token não é dado da prova, e o campo oculto é a forma que o
        próprio ASP.NET Core gera e valida.
    *@
    @Html.AntiForgeryToken()

    <script id="exam-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialData))</script>
    <script src="~/js/exam.js" asp-append-version="true"></script>
</body>
</html>
