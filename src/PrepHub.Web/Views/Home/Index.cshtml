@model InicioViewModel
@{
    ViewData["Title"] = "Início";
}

<section class="hero">
    <h1 class="hero__title">Pratique como na prova real</h1>
    <p class="hero__lead">
        Simulados que replicam a experiência da prova de certificação — timer, navegação entre
        questões, marcação para revisão e score report por domínio. Sem gamificação, sem distração.
    </p>
</section>

@* Avisa antes do botão "Iniciar simulado": quem parou no meio de uma prova deve retomá-la em
   vez de abrir outra e deixar a primeira sem correção. *@
@if (Model.EmAndamento.Count > 0)
{
    <section class="historico__bloco">
        <ul class="historico-lista">
            @foreach (var t in Model.EmAndamento)
            {
                <li class="historico-item historico-item--aberta">
                    <div class="historico-item__info">
                        <span class="exam-card__code">@t.ExamCode</span>
                        <span class="historico-item__data">Você tem um simulado em andamento</span>
                        <span class="historico-item__progresso">
                            Iniciado em @t.StartedAt.ToLocalTime().ToString("dd/MM 'às' HH:mm") ·
                            @t.QuestoesRespondidas de @t.TotalDeQuestoes itens respondidos
                        </span>
                    </div>
                    <a class="btn btn--primary" asp-controller="Exame" asp-action="Realizar"
                       asp-route-attemptId="@t.Id">Retomar</a>
                </li>
            }
        </ul>
    </section>
}

<section class="exam-list">
    @if (Model.Exames.Count == 0)
    {
        <h2 class="section-title">Exames disponíveis</h2>
        <p class="empty-state">Nenhum exame cadastrado ainda.</p>
    }
    else
    {
        @*
            Um bloco por fornecedor, na ordem do enum (Microsoft antes de AWS). A separação não é só
            visual: as duas provas são entregues em telas diferentes, com escala de nota e formatos
            próprios, e quem estuda para uma certificação procura só os exames daquele fornecedor.
            As abas só mostram e escondem os blocos no navegador (catalogo.js): trocar de aba não
            recarrega a página nem muda a URL. Elas nascem ocultas e o script as revela, então sem
            JavaScript a tela continua útil, com os dois blocos visíveis e nenhum botão inerte.
            Fornecedor sem exame publicado não ganha aba nem bloco vazio.
        *@
        var grupos = Model.Exames.GroupBy(e => e.Vendor).OrderBy(g => g.Key).ToList();

        <div class="vendor-tabs" role="group" aria-label="Filtrar simulados por fornecedor" data-vendor-tabs hidden>
            <button type="button" class="vendor-tabs__tab is-active" data-vendor-filter="todos" aria-pressed="true">
                Todos <span class="vendor-tabs__count">@Model.Exames.Count</span>
            </button>
            @foreach (var grupo in grupos)
            {
                <button type="button" class="vendor-tabs__tab" data-vendor-filter="@InicioViewModel.Identificador(grupo.Key)" aria-pressed="false">
                    @InicioViewModel.NomeExibido(grupo.Key) <span class="vendor-tabs__count">@grupo.Count()</span>
                </button>
            }
        </div>

        foreach (var grupo in grupos)
        {
            <div class="exam-group" data-vendor="@InicioViewModel.Identificador(grupo.Key)">
                <h2 class="section-title exam-group__title">
                    @InicioViewModel.NomeExibido(grupo.Key)
                    <span class="exam-group__count">@grupo.Count() @(grupo.Count() == 1 ? "simulado" : "simulados")</span>
                </h2>
                <div class="exam-grid">
                    @foreach (var exam in grupo)
                    {
                        <article class="exam-card">
                            <header class="exam-card__header">
                                <span class="exam-card__code">@exam.Code</span>
                                <h3 class="exam-card__name">@exam.Name</h3>
                            </header>
                            <dl class="exam-card__meta">
                                <div>
                                    <dt>Questões</dt>
                                    <dd>@exam.TotalQuestions</dd>
                                </div>
                                <div>
                                    <dt>Tempo</dt>
                                    <dd>@exam.TimeLimitMinutes min</dd>
                                </div>
                                <div>
                                    <dt>Nota de corte</dt>
                                    <dd>700 / 1000</dd>
                                </div>
                            </dl>
                            @if (exam.Vendor == FornecedorDoExame.Aws)
                            {
                                @* Na AWS a prova começa pela tela de instruções; o POST que cria a tentativa sai de lá. *@
                                <div class="exam-card__action">
                                    <a class="btn btn--primary" asp-controller="Exame" asp-action="Instrucoes" asp-route-examId="@exam.Id">Iniciar simulado</a>
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Exame" asp-action="Iniciar" method="post" class="exam-card__action">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="examId" value="@exam.Id" />
                                    <button type="submit" class="btn btn--primary">Iniciar simulado</button>
                                </form>
                            }
                        </article>
                    }
                </div>
            </div>
        }
    }
</section>

@section Scripts {
    <script src="~/js/catalogo.js" asp-append-version="true"></script>
}
