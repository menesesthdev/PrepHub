# Build
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/

# Banco SQLite local (recriado no startup via Migrate + Seed)
*.db
*.db-shm
*.db-wal
src/PrepHub.Web/App_Data/*.db*
*.design.db*

# Chaves de Data Protection (criptografam o cookie de autenticação) — material
# sensível gerado por instância, nunca versionado
src/PrepHub.Web/App_Data/dp-keys/

# Documentação interna de sessões (não versionada)
/docs/

# Credenciais do container (OAuth, SMTP) — o modelo versionado é o .env.exemplo
.env

# Ajustes de compose específicos da máquina (limites de memória/CPU, perfis). O compose carrega
# este arquivo automaticamente, então versioná-lo aplicaria os limites de uma VM pequena em
# qualquer clone — inclusive num servidor grande, onde só atrapalhariam.
docker-compose.override.yml

# IDE / usuário
.vs/
.vscode/
.idea/
*.user
*.suo

# Config local do Claude Code (específica da máquina, não compartilhada)
.claude/

# .NET
project.lock.json
*.nupkg
TestResults/
[Cc]overage*/
